# URL shortener configuration (all optional; defaults shown). Copy to .env for local runs.
# Secrets: never commit real values. Use your secret manager in deployed environments.

# --- core ---
SHORTENER_ENVIRONMENT=dev
SHORTENER_BASE_URL=http://localhost:8000
SHORTENER_DATABASE_URL=sqlite+aiosqlite:///./shortener.db
# SHORTENER_DATABASE_URL=postgresql+asyncpg://shortener:password@localhost:5432/shortener
SHORTENER_DB_AUTO_MIGRATE=true
SHORTENER_DB_POOL_SIZE=10
SHORTENER_REDIRECT_STATUS_CODE=302
SHORTENER_CODE_LENGTH=7
SHORTENER_CODE_MAX_ATTEMPTS=5
SHORTENER_ALLOW_PRIVATE_HOSTS=false
SHORTENER_MAX_URL_LENGTH=2048
SHORTENER_MAX_REQUEST_BODY_BYTES=16384
SHORTENER_CORS_ORIGINS=[]
SHORTENER_HSTS_ENABLED=false
SHORTENER_LOG_LEVEL=INFO
SHORTENER_LOG_JSON=true

# --- auth (write endpoints require X-API-Key; create keys with `python -m service.cli create-key`) ---
SHORTENER_AUTH_ENABLED=true

# --- analytics ---
SHORTENER_ANALYTICS_ENABLED=true
# REQUIRED in production: a long random secret (e.g. `openssl rand -hex 32`). If unset, a random
# per-process value is used and unique-visitor counts reset on restart.
SHORTENER_ANALYTICS_SALT_SECRET=
SHORTENER_ANALYTICS_RETENTION_DAYS=90
SHORTENER_ANALYTICS_QUEUE_SIZE=10000
SHORTENER_ANALYTICS_BATCH_SIZE=200
SHORTENER_ANALYTICS_PURGE_INTERVAL_S=3600

# --- cache and rate limiting (Redis shared across replicas; in-memory fallback when unset) ---
# SHORTENER_REDIS_URL=redis://localhost:6379/0
SHORTENER_CACHE_ENABLED=true
SHORTENER_CACHE_TTL_S=300
SHORTENER_CACHE_NEGATIVE_TTL_S=5
SHORTENER_CACHE_MAX_ENTRIES=10000
SHORTENER_RATE_LIMIT_ENABLED=true
SHORTENER_RATE_LIMIT_WRITE_CAPACITY=60
SHORTENER_RATE_LIMIT_WRITE_REFILL_PER_S=1.0
SHORTENER_RATE_LIMIT_REDIRECT_CAPACITY=300
SHORTENER_RATE_LIMIT_REDIRECT_REFILL_PER_S=50
SHORTENER_METRICS_ENABLED=true

# --- orchestrator (optional) ---
# ANTHROPIC_API_KEY=            # enables the Claude provider; everything works without it
# ORCH_MODEL=claude-opus-5-5
# ORCH_APPROVER=you@example.com # identity recorded on approvals (defaults to git user.email)
