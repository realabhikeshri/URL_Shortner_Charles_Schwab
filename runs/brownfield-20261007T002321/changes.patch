+async def test_analytics_failure_never_breaks_redirect(
+    app: FastAPI, client: AsyncClient, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    code = (await client.post("/api/v1/links", json={"url": "https://e.com/f"})).json()["code"]
+
+    def explode(event: object) -> bool:
+        raise RuntimeError("queue exploded")
+
+    monkeypatch.setattr(app.state.recorder, "record", explode)
+    assert (await client.get(f"/{code}")).status_code == 302
+
+    monkeypatch.undo()
+
+    async def db_down(batch: object) -> None:
+        raise ConnectionError("analytics DB unavailable")
+
+    monkeypatch.setattr(app.state.recorder, "_persist", db_down)
+    assert (await client.get(f"/{code}")).status_code == 302
+    await app.state.recorder.flush()
+    assert app.state.recorder.failed >= 1
+
