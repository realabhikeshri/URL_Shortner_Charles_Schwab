+
+async def test_oversized_body_is_rejected(client: AsyncClient) -> None:
+    resp = await client.post(
+        "/api/v1/links", content=b"x" * 20_000, headers={"Content-Type": "application/json"}
+    )
+    assert resp.status_code == 413
+    assert resp.json()["error"]["code"] == "payload_too_large"
+
+
+async def test_unhandled_errors_return_500_envelope(settings: Settings) -> None:
+    app: FastAPI = create_app(settings)
+
+    @app.get("/api/v1/boom")
+    async def boom() -> None:
+        raise RuntimeError("kaboom")
+
+    async with app.router.lifespan_context(app):
+        transport = ASGITransport(app=app, raise_app_exceptions=False)
+        async with AsyncClient(transport=transport, base_url="http://t") as c:
+            resp = await c.get("/api/v1/boom")
+    assert resp.status_code == 500
+    assert resp.json()["error"]["code"] == "internal_error"
+    assert "kaboom" not in resp.text
+
+
+async def test_cors_and_hsts_when_configured(settings: Settings) -> None:
+    configured = settings.model_copy(
+        update={"cors_origins": ["https://app.example.com"], "hsts_enabled": True}
+    )
+    app = create_app(configured)
+    async with (
+        app.router.lifespan_context(app),
+        AsyncClient(transport=ASGITransport(app=app), base_url="http://t") as c,
+    ):
+        resp = await c.get("/healthz", headers={"Origin": "https://app.example.com"})
+    assert resp.headers["access-control-allow-origin"] == "https://app.example.com"
+    assert "max-age" in resp.headers["Strict-Transport-Security"]
+
+
+async def test_startup_runs_migrations_on_a_fresh_database(tmp_path: object) -> None:
+    from pathlib import Path
+
+    db = Path(str(tmp_path)) / "fresh.db"
+    app = create_app(Settings(database_url=f"sqlite+aiosqlite:///{db}", log_json=False))
+    async with (
+        app.router.lifespan_context(app),
+        AsyncClient(transport=ASGITransport(app=app), base_url="http://t") as c,
+    ):
+        assert (await c.get("/readyz")).status_code == 200
+    assert db.exists()
+
+
+def test_json_formatter_includes_request_id_and_extras() -> None:
+    token = request_id_var.set("rid-1")
+    try:
+        record = logging.LogRecord("service.x", logging.INFO, __file__, 1, "hello %s", ("w",), None)
+        record.route = "/x"
+        out = json.loads(JsonFormatter().format(record))
+    finally:
+        request_id_var.reset(token)
+    assert out["message"] == "hello w"
+    assert out["request_id"] == "rid-1"
+    assert out["route"] == "/x"
+    assert out["level"] == "INFO"
+
+
+def test_settings_strip_trailing_slash() -> None:
+    assert Settings(base_url="https://s.io/").base_url == "https://s.io"
+
+
+def test_settings_load_from_environment(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setenv("SHORTENER_REDIRECT_STATUS_CODE", "307")
+    monkeypatch.setenv("SHORTENER_CORS_ORIGINS", '["https://app.example.com"]')
+    settings = Settings()
+    assert settings.redirect_status_code == 307
+    assert settings.cors_origins == ["https://app.example.com"]
+    monkeypatch.setenv("SHORTENER_REDIRECT_STATUS_CODE", "301")
+    with pytest.raises(ValueError, match="302 or 307"):
+        Settings()
