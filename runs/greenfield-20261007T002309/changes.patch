+# lineage: REQ-GF-001 / implement.foundation (see runs/ for the decision trail)
+"""Create the links table.
+
+Revision ID: 0001
+Revises:
+Create Date: 2026-10-07
+"""
+
+from collections.abc import Sequence
+
+import sqlalchemy as sa
