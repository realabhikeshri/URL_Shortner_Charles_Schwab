+# lineage: REQ-GF-001 / implement.links_api (see runs/ for the decision trail)
+"""Link management API (/api/v1/links)."""
+
+from typing import Annotated
+
+from fastapi import APIRouter, Depends, Header, Response, status
+
+from service.api.deps import get_link_service
+from service.links import LinkService
+from service.schemas import LinkCreate, LinkOut, LinkUpdate
+
+router = APIRouter(prefix="/api/v1/links", tags=["links"])
+Service = Annotated[LinkService, Depends(get_link_service)]
+
+
+@router.post("", status_code=status.HTTP_201_CREATED, response_model=LinkOut)
+async def create_link(
+    payload: LinkCreate,
+    response: Response,
+    service: Service,
+    idempotency_key: Annotated[str | None, Header(alias="Idempotency-Key", max_length=128)] = None,
+) -> LinkOut:
+    link, created = await service.create(payload, idempotency_key)
+    if not created:
+        response.headers["Idempotent-Replayed"] = "true"
+    response.headers["Location"] = f"/api/v1/links/{link.code}"
+    return service.to_out(link)
+
+
+@router.get("/{code}", response_model=LinkOut)
+async def get_link(code: str, service: Service) -> LinkOut:
+    return service.to_out(await service.get(code))
+
+
+@router.patch("/{code}", response_model=LinkOut)
+async def update_link(code: str, patch: LinkUpdate, service: Service) -> LinkOut:
+    return service.to_out(await service.update(code, patch))
+
+
+@router.delete("/{code}", status_code=status.HTTP_204_NO_CONTENT)
+async def delete_link(code: str, service: Service) -> Response:
+    await service.delete(code)
+    return Response(status_code=status.HTTP_204_NO_CONTENT)
