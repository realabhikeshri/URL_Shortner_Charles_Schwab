{
  "components": {
    "schemas": {
      "DayStats": {
        "properties": {
          "clicks": {
            "title": "Clicks",
            "type": "integer"
          },
          "day": {
            "title": "Day",
            "type": "string"
          },
          "unique_visitors": {
            "title": "Unique Visitors",
            "type": "integer"
          }
        },
        "required": [
          "day",
          "clicks",
          "unique_visitors"
        ],
        "title": "DayStats",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LinkCreate": {
        "additionalProperties": false,
        "properties": {
          "custom_alias": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "launch-2026"
            ],
            "title": "Custom Alias"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Timezone-aware expiry (must be in the future)",
            "title": "Expires At"
          },
          "tags": {
            "items": {
              "maxLength": 32,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "type": "string"
            },
            "maxItems": 10,
            "title": "Tags",
            "type": "array"
          },
          "url": {
            "examples": [
              "https://example.com/docs"
            ],
            "maxLength": 8192,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "LinkCreate",
        "type": "object"
      },
      "LinkOut": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "disabled": {
            "title": "Disabled",
            "type": "boolean"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "is_custom": {
            "title": "Is Custom",
            "type": "boolean"
          },
          "is_expired": {
            "default": false,
            "title": "Is Expired",
            "type": "boolean"
          },
          "short_url": {
            "title": "Short Url",
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "target_url": {
            "title": "Target Url",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "code",
          "short_url",
          "target_url",
          "is_custom",
          "tags",
          "disabled",
          "created_at",
          "updated_at"
        ],
        "title": "LinkOut",
        "type": "object"
      },
      "LinkStats": {
        "properties": {
          "clicks_by_day": {
            "items": {
              "$ref": "#/components/schemas/DayStats"
            },
            "title": "Clicks By Day",
            "type": "array"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "top_referrers": {
            "items": {
              "$ref": "#/components/schemas/Referrer"
            },
            "title": "Top Referrers",
            "type": "array"
          },
          "top_user_agents": {
            "items": {
              "$ref": "#/components/schemas/UserAgentFamily"
            },
            "title": "Top User Agents",
            "type": "array"
          },
          "total_clicks": {
            "title": "Total Clicks",
            "type": "integer"
          },
          "unique_visitors": {
            "title": "Unique Visitors",
            "type": "integer"
          },
          "window_days": {
            "title": "Window Days",
            "type": "integer"
          }
        },
        "required": [
          "code",
          "window_days",
          "total_clicks",
          "unique_visitors",
          "clicks_by_day",
          "top_referrers",
          "top_user_agents"
        ],
        "title": "LinkStats",
        "type": "object"
      },
      "LinkUpdate": {
        "additionalProperties": false,
        "properties": {
          "disabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disabled"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set a new expiry; null clears it",
            "title": "Expires At"
          }
        },
        "title": "LinkUpdate",
        "type": "object"
      },
      "Referrer": {
        "properties": {
          "clicks": {
            "title": "Clicks",
            "type": "integer"
          },
          "host": {
            "title": "Host",
            "type": "string"
          }
        },
        "required": [
          "host",
          "clicks"
        ],
        "title": "Referrer",
        "type": "object"
      },
      "UserAgentFamily": {
        "properties": {
          "clicks": {
            "title": "Clicks",
            "type": "integer"
          },
          "family": {
            "title": "Family",
            "type": "string"
          }
        },
        "required": [
          "family",
          "clicks"
        ],
        "title": "UserAgentFamily",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "URL Shortener",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/links": {
      "post": {
        "operationId": "create_link_api_v1_links_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Link",
        "tags": [
          "links"
        ]
      }
    },
    "/api/v1/links/{code}": {
      "delete": {
        "operationId": "delete_link_api_v1_links__code__delete",
        "parameters": [
          {
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "title": "Code",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Link",
        "tags": [
          "links"
        ]
      },
      "get": {
        "operationId": "get_link_api_v1_links__code__get",
        "parameters": [
          {
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "title": "Code",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Link",
        "tags": [
          "links"
        ]
      },
      "patch": {
        "operationId": "update_link_api_v1_links__code__patch",
        "parameters": [
          {
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "title": "Code",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Link",
        "tags": [
          "links"
        ]
      }
    },
    "/api/v1/links/{code}/stats": {
      "get": {
        "description": "Unique visitors are counted per day (daily-salted hashes) and summed over the window.",
        "operationId": "stats_api_v1_links__code__stats_get",
        "parameters": [
          {
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "title": "Code",
              "type": "string"
            }
          },
          {
            "description": "Window size in days",
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "default": 30,
              "description": "Window size in days",
              "maximum": 365,
              "minimum": 1,
              "title": "Days",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkStats"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Click statistics",
        "tags": [
          "analytics"
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness probe (database and cache reachable)",
        "tags": [
          "health"
        ]
      }
    },
    "/{code}": {
      "get": {
        "operationId": "follow__code__get",
        "parameters": [
          {
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Code",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Unknown code"
          },
          "410": {
            "description": "Expired or disabled"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "summary": "Follow",
        "tags": [
          "redirect"
        ]
      }
    }
  }
}
